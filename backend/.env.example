# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
# BASE_URL dipakai untuk membangun tautan share patungan & QR pembayaran
BASE_URL=http://localhost:3000

# Database (digunakan mulai TAHAP 2)
DATABASE_URL=postgresql://cinegen:cinegen@localhost:5432/cinegen?schema=public

# Redis (digunakan mulai TAHAP 3 - seat locking)
REDIS_URL=redis://localhost:6379

# JWT Auth (digunakan mulai TAHAP 3)
JWT_ACCESS_SECRET=ganti-dengan-secret-acak
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain
JWT_REFRESH_EXPIRES_IN=7d

# Seat locking (TAHAP 3): umur kunci kursi dalam detik
SEAT_LOCK_TTL_SECONDS=600

# Split Bill (TAHAP 5): umur tautan patungan dalam menit (30 - 10080)
SPLIT_SHARE_TTL_MINUTES=1440

# AI Engine (digunakan mulai TAHAP 5)
# Kosongkan untuk memakai mesin rekomendasi lokal; isi untuk memakai Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Batas waktu panggilan LLM (ms) agar rekomendasi tetap < 2.5 detik
AI_TIMEOUT_MS=2000

# Payment Gateway (digunakan mulai TAHAP 6)
# Kosongkan SERVER_KEY untuk memakai gateway 'simulated' (dev/test, tanpa jaringan).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_VA_BANK=bca

# Rahasia untuk menandatangani payload QR e-ticket & F&B (HMAC-SHA256).
# Wajib nilai acak di production; gunakan secret berbeda dari JWT.
TICKET_QR_SECRET=ganti-dengan-secret-acak-qr
